{
  "crawler_agent": {
    "default_urls": [
      "https://es.wikipedia.org/wiki/C%C3%B3ctel",
      "https://en.wikipedia.org/wiki/List_of_cocktails"
    ],
    "max_depth": 2,
    "ant_colony": {
      "num_ants": 8,
      "alpha": 1.0,
      "beta": 2.0,
      "evaporation_rate": 0.1,
      "deposit_factor": 1.0,
      "cocktail_keywords": [
        "cocktail", "coctel", "cóctel", "drink", "bebida", 
        "bartender", "recipe", "receta", "ingredients", "ingredientes",
        "gin", "vodka", "rum", "tequila", "whiskey", "whisky", "bourbon"
      ],
      "trusted_domains_weight": {
        "wikipedia.org": 0.9,
        "liquor.com": 0.8,
        "diffordsguide.com": 0.8,
        "iba-world.com": 0.7,
        "thespruceeats.com": 0.7
      },
      "blacklist_patterns": [
        "Special:", "User:", "Talk:", "File:", "Template:", "Help:", 
        "Category_talk:", "disambiguation", "desambiguación"
      ]
    }
  },
  "vectorizer_agent": {
    "model_name": "sentence-transformers/all-mpnet-base-v2",
    "chunk_size": 512,
    "chunk_overlap": 50
  },
  "retrieval_agent": {
    "max_results": 20,
    "similarity_threshold": 0.6
  },
  "search_agent": {
    "max_results": 20,
    "show_scores": true
  },
  "generation_agent": {
    "model": "accounts/fireworks/models/mixtral-8x22b-instruct",
    "temperature": 0.4,
    "top_k": 32,
    "top_p": 0.95,
    "max_output_tokens": 2048
  },
  "coordinator_agent": {
    "timeout": 60
  },
  "ontology_agent": {
    "batch_size": 3
  },
  "strategy_agent": {
    "model": "accounts/fireworks/models/mixtral-8x22b-instruct",
    "temperature": 0.1
  }
}
